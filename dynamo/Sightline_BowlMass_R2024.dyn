          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Draws the stands as Dynamo geometry (metres) in the 3D background preview. Does not change the Revit model."
    }
