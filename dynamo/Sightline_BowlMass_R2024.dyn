    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Sightline Bowl Mass  |  Dynamo 2.17 (CPython3)  |  Revit 2024\n# Builds every stand (tier x side) of a Sightline bowl option inside the open family:\n#   straight runs of the focal boundary  -> extrusion of the tier profile\n#   corners and curves                   -> revolve of the profile about a vertical axis\n# Each stand has its own profile; open corners are simply gaps between stands. Seat counts match Sightline.\n# Base version: Revit 2024.0 (Dynamo 2.17). Reads Bowl pieces (zoned exports) or, for older exports, Tier N profile + Focal path.\n# Inputs: IN[0] Sightline workbook (.xlsx)  IN[1] Mass category  IN[2] Draw focal boundary lines\nimport clr, math, re, os, zipfile\nimport xml.etree.ElementTree as ET\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *\nclr.AddReference('RevitServices')\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\nMM = 1.0 / 304.8                       # Revit works in feet\nNS = '{http://schemas.openxmlformats.org/spreadsheetml/2006/main}'\nRID = '{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id'\nTIER_COLOURS = [(150, 150, 150), (110, 140, 180), (185, 135, 95)]\n\n\nclass Stop(Exception):\n    pass\n\n\n# ---------- Excel, read with the standard library (no Excel install needed) ----------\ndef col_of(ref):\n    n = 0\n    for ch in ref:\n        if not ch.isalpha():\n            break\n        n = n * 26 + ord(ch.upper()) - 64\n    return n - 1\n\n\ndef read_xlsx(p):\n    with zipfile.ZipFile(p) as z:\n        names = set(z.namelist())\n        shared = []\n        if 'xl/sharedStrings.xml' in names:\n            for si in ET.fromstring(z.read('xl/sharedStrings.xml')).iter(NS + 'si'):\n                shared.append(''.join(t.text or '' for t in si.iter(NS + 't')))\n        rels = {r.get('Id'): r.get('Target') for r in ET.fromstring(z.read('xl/_rels/workbook.xml.rels'))}\n        book = {}\n        for sh in ET.fromstring(z.read('xl/workbook.xml')).iter(NS + 'sheet'):\n            t = (rels.get(sh.get(RID)) or '').replace('\\\\', '/')\n            t = t[1:] if t.startswith('/') else (t if t.startswith('xl/') else 'xl/' + t)\n            if t not in names:\n                continue\n            rows = []\n            for row in ET.fromstring(z.read(t)).iter(NS + 'row'):\n                vals = []\n                for c in row.iter(NS + 'c'):\n                    i = col_of(c.get('r')) if c.get('r') else len(vals)\n                    while len(vals) < i:\n                        vals.append(None)\n                    typ, v = c.get('t'), c.find(NS + 'v')\n                    if typ == 's':\n                        val = shared[int(v.text)]\n                    elif typ == 'inlineStr':\n                        val = ''.join(x.text or '' for x in c.iter(NS + 't'))\n                    elif typ in ('str', 'e'):\n                        val = v.text if v is not None else ''\n                    elif typ == 'b':\n                        val = v is not None and v.text == '1'\n                    else:\n                        val = float(v.text) if v is not None and v.text not in (None, '') else None\n                    vals.append(val)\n                rows.append(vals)\n            book[sh.get('name')] = rows\n    return book\n\n\ndef num(v):\n    try:\n        return float(v)\n    except (TypeError, ValueError):\n        return None\n\n\ndef seg_of(t, r):\n    if t == 'LINE':\n        return ('LINE', num(r[0]), num(r[1]), num(r[2]), num(r[3]))\n    if t == 'ARC':\n        return ('ARC', num(r[4]), num(r[5]), num(r[6]), num(r[7]), num(r[8]))\n    return None\n\n\ndef profile_pts(rows):\n    return [(num(r[1]), num(r[2])) for r in rows[1:] if len(r) >= 3 and num(r[1]) is not None and num(r[2]) is not None]\n\n\ndef load(p):\n    \"\"\"-> summary, stands: list of (tier, zone, profile points, [segments]) in build order.\"\"\"\n    if not p or not os.path.isfile(str(p)):\n        raise Stop('Pick the workbook you exported from Sightline (Export for Revit).')\n    try:\n        book = read_xlsx(str(p))\n    except Exception as e:\n        raise Stop('Could not read that file as an Excel workbook: %s' % e)\n    summary = {}\n    for r in book.get('Summary', []):\n        if len(r) >= 2 and r[0] not in (None, '') and not isinstance(r[0], float):\n            summary[str(r[0]).strip()] = r[1]\n    stands, order = {}, []\n    if 'Bowl pieces' in book:                                   # zoned export: every stand has its own profile\n        for r in book['Bowl pieces'][1:]:\n            r = list(r) + [None] * 16\n            t = str(r[4] or '').strip().upper()\n            seg = seg_of(t, r[5:14])\n            if seg is None:\n                continue\n            if any(v is None for v in seg[1:]):\n                raise Stop('Bowl pieces row %s is incomplete.' % r[0])\n            key = (int(num(r[1]) or 0), str(r[2]).strip(), str(r[3]).strip())\n            if key not in stands:\n                stands[key] = []\n                order.append(key)\n            stands[key].append(seg)\n        out = []\n        for tier, zone, sheet in order:\n            if sheet not in book:\n                raise Stop('Profile sheet \"%s\" is missing from the workbook.' % sheet)\n            out.append((tier, zone, profile_pts(book[sheet]), stands[(tier, zone, sheet)]))\n    else:                                                       # older export: one profile per tier, all the way round\n        if 'Focal path' not in book:\n            raise Stop('This workbook has no Bowl pieces or Focal path sheet. Open Sightline and click Export for Revit again.')\n        segs = []\n        for r in book['Focal path'][1:]:\n            r = list(r) + [None] * 12\n            seg = seg_of(str(r[1] or '').strip().upper(), r[2:11])\n            if seg is not None and all(v is not None for v in seg[1:]):\n                segs.append(seg)\n        out = []\n        for name, rows in book.items():\n            m = re.match(r'^Tier (\\d+) profile$', name.strip())\n            if m:\n                out.append((int(m.group(1)), 'All', profile_pts(rows), segs))\n        out.sort(key=lambda x: x[0])\n    if not out:\n        raise Stop('No stands found in this workbook. Is this a Sightline export?')\n    return summary, out\n\n\n# ---------- geometry ----------\ndef clean(pts):\n    \"\"\"Drop repeated points, the closing duplicate and collinear midpoints; Revit rejects lines under ~1 mm.\"\"\"\n    out = []\n    for p in pts:\n        if not out or math.hypot(p[0] - out[-1][0], p[1] - out[-1][1]) > 1.0:\n            out.append(p)\n    while len(out) > 2 and math.hypot(out[0][0] - out[-1][0], out[0][1] - out[-1][1]) <= 1.0:\n        out.pop()\n    i = 0\n    while len(out) > 3 and i < len(out):\n        a, b, c = out[i - 1], out[i], out[(i + 1) % len(out)]\n        cr = (b[0] - a[0]) * (c[1] - b[1]) - (b[1] - a[1]) * (c[0] - b[0])\n        if abs(cr) < 1e-6 * math.hypot(b[0] - a[0], b[1] - a[1]) * math.hypot(c[0] - b[0], c[1] - b[1]) + 1e-9:\n            out.pop(i)\n            i = max(i - 1, 0)\n        else:\n            i += 1\n    return out\n\n\ndef ends_of(s):\n    if s[0] == 'LINE':\n        return (s[1], s[2]), (s[3], s[4])\n    cx, cy, r, a0, sw = s[1:]\n    a, b = math.radians(a0), math.radians(a0 + sw)\n    return (cx + r * math.cos(a), cy + r * math.sin(a)), (cx + r * math.cos(b), cy + r * math.sin(b))\n\n\ndef stand_gap(segs):\n    \"\"\"Largest break between consecutive pieces of one stand (mm). A closed ring is also checked end to start.\"\"\"\n    e = [ends_of(s) for s in segs]\n    gaps = [math.hypot(e[i][0][0] - e[i - 1][1][0], e[i][0][1] - e[i - 1][1][1]) for i in range(1, len(e))]\n    turn = sum(s[5] for s in segs if s[0] == 'ARC')\n    if abs(turn - 360) < 1:\n        gaps.append(math.hypot(e[0][0][0] - e[-1][1][0], e[0][0][1] - e[-1][1][1]))\n    return max(gaps) if gaps else 0.0\n\n\ndef focal_segs(path, stands):\n    try:\n        book = read_xlsx(str(path))\n        out = []\n        for r in book.get('Focal path', [])[1:]:\n            r = list(r) + [None] * 12\n            seg = seg_of(str(r[1] or '').strip().upper(), r[2:11])\n            if seg is not None and all(v is not None for v in seg[1:]):\n                out.append(seg)\n        return out\n    except Exception:\n        return []\n\n\ndef load_plates(p):\n    \"\"\"Chamfered corners: list of (tier, zone, [(x,y) x4], z0, z1) in mm.\"\"\"\n    try:\n        book = read_xlsx(str(p))\n    except Exception:\n        return []\n    out = []\n    for r in book.get('Corner plates', [])[1:]:\n        r = list(r) + [None] * 14\n        v = [num(x) for x in r[3:13]]\n        if num(r[0]) is None or any(x is None for x in v):\n            continue\n        out.append((int(num(r[1])), str(r[2]).strip(), [(v[0], v[1]), (v[2], v[3]), (v[4], v[5]), (v[6], v[7])], v[8], v[9]))\n    return out\n\n\ndef build_plate(doc, pts, z0, z1, sub, stats):\n    if z1 - z0 < 1:\n        return\n    q = []\n    for p in pts:                                          # the chamfer starts at a point: drop repeated corners\n        if not q or math.hypot(p[0] - q[-1][0], p[1] - q[-1][1]) > 1:\n            q.append(p)\n    while len(q) > 2 and math.hypot(q[0][0] - q[-1][0], q[0][1] - q[-1][1]) <= 1:\n        q.pop()\n    if len(q) < 3:\n        return\n    try:\n        p3 = [XYZ(x * MM, y * MM, z0 * MM) for x, y in q]\n        sp = SketchPlane.Create(doc, Plane.CreateByNormalAndOrigin(XYZ(0, 0, 1), XYZ(0, 0, z0 * MM)))\n        f = doc.FamilyCreate.NewExtrusion(True, curve_loop(p3), sp, (z1 - z0) * MM)\n        stats['plate'] += 1\n        try:\n            f.Subcategory = sub\n        except Exception:\n            pass\n    except Exception as e:\n        stats['fail'] += 1\n        if not stats['err']:\n            stats['err'] = 'corner plate: %s' % e\n\n\ndef curve_loop(p3):\n    ca = CurveArray()\n    for i in range(len(p3)):\n        ca.Append(Line.CreateBound(p3[i], p3[(i + 1) % len(p3)]))\n    arr = CurveArrArray()\n    arr.Append(ca)\n    return arr\n\n\ndef build(doc, prof, segs, sub, stats):\n    fc = doc.FamilyCreate\n    for s in segs:\n        try:\n            if s[0] == 'LINE':\n                x1, y1, x2, y2 = s[1:]\n                L = math.hypot(x2 - x1, y2 - y1)\n                if L < 5:\n                    continue\n                ux, uy = (x2 - x1) / L, (y2 - y1) / L\n                nx, ny = uy, -ux                                  # outward: the loop runs counter-clockwise\n                mx, my = (x1 + x2) / 2.0, (y1 + y2) / 2.0\n                p3 = [XYZ((mx + nx * x) * MM, (my + ny * x) * MM, z * MM) for x, z in prof]\n                sp = SketchPlane.Create(doc, Plane.CreateByNormalAndOrigin(XYZ(ux, uy, 0), XYZ(mx * MM, my * MM, 0)))\n                f = fc.NewExtrusion(True, curve_loop(p3), sp, L / 2.0 * MM)\n                f.StartOffset = -L / 2.0 * MM                     # symmetric about mid-edge, so direction can't flip\n                stats['ext'] += 1\n            else:\n                cx, cy, r, a0, sw = s[1:]\n                if sw < 0.05:\n                    continue\n                f = revolve(doc, prof, cx, cy, r, a0, sw, stats)\n                stats['rev'] += 1\n            try:\n                f.Subcategory = sub\n            except Exception:\n                pass\n        except Stop:\n            raise\n        except Exception as e:\n            stats['fail'] += 1\n            if not stats['err']:\n                stats['err'] = '%s at %s: %s' % (s[0], tuple(round(v) for v in s[1:3]), e)\n\n\ndef revolve_at(doc, prof, cx, cy, r, ang, a, b):\n    rx, ry = math.cos(math.radians(ang)), math.sin(math.radians(ang))\n    p3 = [XYZ((cx + rx * (r + x)) * MM, (cy + ry * (r + x)) * MM, z * MM) for x, z in prof]\n    C = XYZ(cx * MM, cy * MM, 0)\n    sp = SketchPlane.Create(doc, Plane.CreateByNormalAndOrigin(XYZ(ry, -rx, 0), C))   # plane holds the axis and the radius\n    axis = Line.CreateBound(C, XYZ(cx * MM, cy * MM, 10.0))\n    return doc.FamilyCreate.NewRevolution(True, curve_loop(p3), sp, axis, a, b)\n\n\ndef revolve(doc, prof, cx, cy, r, a0, sw, stats):\n    h = math.radians(sw) / 2.0\n    if stats['mode'] == 'sym':                                   # profile at mid-angle, -h..+h: direction-proof\n        try:\n            return revolve_at(doc, prof, cx, cy, r, a0 + sw / 2.0, -h, h)\n        except Exception:\n            stats['mode'] = sense(doc)\n    start = a0 if stats['mode'] == 'ccw' else a0 + sw\n    return revolve_at(doc, prof, cx, cy, r, start, 0.0, 2 * h)\n\n\ndef sense(doc):\n    \"\"\"Fallback if negative start angles are refused: revolve a test square 90 degrees and see which way it went.\"\"\"\n    t, mode = None, 'ccw'\n    try:\n        t = revolve_at(doc, [(10000, 0), (11000, 0), (11000, 1000), (10000, 1000)], 0, 0, 0, 0, 0.0, math.pi / 2)\n        doc.Regenerate()\n        bb = t.get_BoundingBox(None)\n        mode = 'ccw' if (bb.Min.Y + bb.Max.Y) / 2.0 > 0 else 'cw'\n    except Exception:\n        pass\n    finally:\n        if t is not None:\n            try:\n                doc.Delete(t.Id)\n            except Exception:\n                pass\n    return mode\n\n\ndef subcategory(doc, parent, name, rgb):\n    for c in parent.SubCategories:\n        if c.Name == name:\n            sub = c\n            break\n    else:\n        sub = doc.Settings.Categories.NewSubcategory(parent, name)\n    try:\n        sub.LineColor = Color(*rgb)\n    except Exception:\n        pass\n    return sub\n\n\ndef is_ours(el):\n    try:\n        sc = el.Subcategory\n        if sc is not None and sc.Name.startswith('Sightline'):\n            return True\n    except Exception:\n        pass\n    try:\n        return el.LineStyle.Name.startswith('Sightline')\n    except Exception:\n        return False\n\n\ndef set_text(doc, name, val):\n    fm = doc.FamilyManager\n    if fm.CurrentType is None:\n        fm.NewType('Sightline')\n    p = None\n    for q in fm.GetParameters():\n        if q.Definition.Name == name:\n            p = q\n    if p is None:\n        p = fm.AddParameter(name, GroupTypeId.IdentityData, SpecTypeId.String.Text, False)\n    fm.Set(p, str(val))\n\n\ndef main(path, as_mass, draw_path):\n    doc = DocumentManager.Instance.CurrentDBDocument\n    if doc is None or not doc.IsFamilyDocument:\n        raise Stop('Run this in a family, not the project: File > New > Family > Metric Generic Model.rft, '\n                   'save it, then run the graph.')\n    fam = doc.OwnerFamily\n    if getattr(fam, 'IsConceptualMassFamily', False):\n        raise Stop('This is a conceptual mass family, which cannot hold extrusions and revolves. '\n                   'Start from Metric Generic Model.rft instead and set \"Mass category\" to True.')\n    cat = fam.FamilyCategory\n    if cat is not None and 'profile' in cat.Name.lower():\n        raise Stop('This is a profile family (for the Sightline_ProfileFamily graph). '\n                   'For the whole bowl, start from Metric Generic Model.rft.')\n\n    summary, stands = load(path)\n    for tier, zone, prof, segs in stands:\n        g = stand_gap(segs)\n        if g > 50:\n            raise Stop('Tier %d %s does not join up (gap %.0f mm). Re-export from Sightline.' % (tier, zone, g))\n\n    stats = {'ext': 0, 'rev': 0, 'plate': 0, 'fail': 0, 'err': '', 'mode': 'sym', 'removed': 0, 'lines': 0}\n    notes = []\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    try:\n        if as_mass:\n            mcat = Category.GetCategory(doc, BuiltInCategory.OST_Mass)\n            if cat is None or cat.Name != mcat.Name:\n                fam.FamilyCategory = mcat\n        cat = fam.FamilyCategory\n\n        old = []                                                   # re-run replaces, never stacks\n        for cls in (Extrusion, Revolution, CurveElement):\n            old += [e.Id for e in FilteredElementCollector(doc).OfClass(cls) if is_ours(e)]\n        for i in old:\n            try:\n                doc.Delete(i)\n                stats['removed'] += 1\n            except Exception:\n                pass\n\n        for tier, zone, pts, segs in stands:\n            prof = clean(pts)\n            if len(prof) < 3:\n                notes.append('Tier %d %s profile has too few points; skipped.' % (tier, zone))\n                continue\n            try:                                               # one subcategory per stand: T2 E, T1 NEZ ...\n                name = 'Sightline T%d %s' % (tier, zone) if zone != 'All' else 'Sightline Tier %d' % tier\n                sub = subcategory(doc, cat, name, TIER_COLOURS[(tier - 1) % 3])\n            except Exception:\n                sub = None\n            build(doc, prof, segs, sub, stats)\n        for tier, zone, pts, z0, z1 in load_plates(path):          # chamfered corners\n            try:\n                sub = subcategory(doc, cat, 'Sightline T%d %s' % (tier, zone), TIER_COLOURS[(tier - 1) % 3])\n            except Exception:\n                sub = None\n            build_plate(doc, pts, z0, z1, sub, stats)\n\n        if draw_path:\n            try:\n                fsub = subcategory(doc, cat, 'Sightline Focal Boundary', (220, 0, 0))\n                style = fsub.GetGraphicsStyle(GraphicsStyleType.Projection)\n            except Exception:\n                style = None\n            sp0 = SketchPlane.Create(doc, Plane.CreateByNormalAndOrigin(XYZ.BasisZ, XYZ.Zero))\n            for s in focal_segs(path, stands):\n                try:\n                    if s[0] == 'LINE':\n                        c = Line.CreateBound(XYZ(s[1] * MM, s[2] * MM, 0), XYZ(s[3] * MM, s[4] * MM, 0))\n                    elif s[3] > 1:\n                        a0 = math.radians(s[4])\n                        c = Arc.Create(XYZ(s[1] * MM, s[2] * MM, 0), s[3] * MM, a0, a0 + math.radians(s[5]), XYZ.BasisX, XYZ.BasisY)\n                    else:\n                        continue\n                    ce = doc.FamilyCreate.NewSymbolicCurve(c, sp0)\n                    if style is not None:\n                        ce.LineStyle = style\n                    stats['lines'] += 1\n                except Exception:\n                    pass\n            if not stats['lines']:\n                notes.append('Focal boundary lines are not allowed in this family type; the bowl was still built.')\n\n        stamp = [('Sightline Option', summary.get('Sightline bowl option', '')),\n                 ('Exported', summary.get('Exported', '')),\n                 ('Sport', summary.get('Sport', '')),\n                 ('Estimated Seats', int(num(summary.get('Estimated seats')) or 0)),\n                 ('Tiers', len(set(t for t, _, _, _ in stands))),\n                 ('Stands', ', '.join('T%d %s' % (t, z) for t, z, _, _ in stands)),\n                 ('Source file', os.path.basename(str(path)))]\n        for k, v in stamp:\n            try:\n                set_text(doc, k, v)\n            except Exception:\n                pass\n    finally:\n        TransactionManager.Instance.TransactionTaskDone()\n\n    opt = str(summary.get('Sightline bowl option', 'Bowl'))\n    seats = num(summary.get('Estimated seats'))\n    nt = len(set(t for t, _, _, _ in stands))\n    lines = ['Built %s: %s, %d tier%s in %d stand%s, %d extrusions + %d revolves + %d corner plates%s.' % (\n        opt, summary.get('Sport', ''), nt, '' if nt == 1 else 's', len(stands), '' if len(stands) == 1 else 's', stats['ext'], stats['rev'], stats['plate'],\n        ', %s seats (Sightline estimate)' % format(int(seats), ',') if seats else '')]\n    if stats['removed']:\n        lines.append('Replaced %d elements from the previous run.' % stats['removed'])\n    if stats['fail']:\n        lines.append('WARNING: %d pieces failed. First: %s' % (stats['fail'], stats['err']))\n    lines += notes\n    lines.append('Category: %s. Origin = field centre at pitch level.' % fam.FamilyCategory.Name)\n    lines.append('Next: Save As Sightline_%s_Bowl.rfa, Load into Project, place at the project base point.' % re.sub(r'\\W+', '', opt))\n    return '\\n'.join(lines)\n\n\ntry:\n    OUT = main(IN[0], bool(IN[1]), bool(IN[2]))\nexcept Stop as e:\n    OUT = 'Stopped: ' + str(e)\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "7e6c5ff9999f42e49197c0fb49b03e25",
      "Inputs": [
        {
          "Id": "c8c753c88d4649dd895fc73c16b568d8",
          "Name": "IN[0]",
          "Description": "Input #0",
